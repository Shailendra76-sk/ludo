PORT=8787
# Add real provider secrets only on the server when integrating payments.
# PAYMENT_PROVIDER=...

# Local development defaults are used only when these are not set.
SUPERADMIN_IDENTIFIER=admin@printerauto.local
SUPERADMIN_PASSWORD=change-this-strong-password

# Supabase/PostgreSQL production migration; never expose the service role key to browsers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=server-safe-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# Platform subscription payments and shop customer payments are separate.
PLATFORM_PAYMENT_PROVIDER=cashfree
PLATFORM_CASHFREE_CLIENT_ID=
PLATFORM_CASHFREE_CLIENT_SECRET=
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=

# Optional sandbox/test webhook signing secret; provider-specific signing is preferred.
PAYMENT_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
RAZORPAY_ENV=test

# Optional connector/agent configuration. Never expose these in frontend code.
CONNECTOR_FILE_MODE=private

# Security hardening
TRUSTED_ORIGINS=https://print.example.com
PRINTER_AUTO_DATA_DIR=/var/lib/printer-auto
BOOTSTRAP_SHOPKEEPER_IDENTIFIER=
BOOTSTRAP_SHOPKEEPER_PASSWORD=
SUPERADMIN_IDENTIFIER=
SUPERADMIN_PASSWORD=

# Phase 5 Super Admin Control Center (server-side only)
PUBLIC_URL_HOSTS=
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_API_KEY=
CASHFREE_ENV=sandbox
CASHFREE_MERCHANT_ACCOUNT_ID=
RAZORPAY_ENV=test
RAZORPAY_ACCOUNT_ID=
